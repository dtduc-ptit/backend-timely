generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String?
  avatar    String?
  role      Role       @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  events    Event[]
  wishlist  Wishlist[]
}

model Product {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  price       BigInt
  productLink String       @map("product_link")
  imageUrl    String       @map("image_url")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tags        ProductTag[]
  wishlists   Wishlist[]
}

model Tag {
  id          Int             @id @default(autoincrement())
  name        String
  slug        String          @unique
  type        TagType
  products    ProductTag[]
  quizOptions QuizOptionTag[]
}

model ProductTag {
  productId Int
  tagId     Int
  product   Product @relation(fields: [productId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
}

model QuizQuestion {
  id         Int          @id @default(autoincrement())
  question   String
  orderIndex Int
  isActive   Boolean      @default(true)
  options    QuizOption[]
}

model QuizOption {
  id         Int             @id @default(autoincrement())
  text       String
  iconUrl    String?
  questionId Int
  question   QuizQuestion    @relation(fields: [questionId], references: [id])
  tags       QuizOptionTag[]
}

model QuizOptionTag {
  optionId Int
  tagId    Int
  option   QuizOption @relation(fields: [optionId], references: [id])
  tag      Tag        @relation(fields: [tagId], references: [id])

  @@id([optionId, tagId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Event {
  id         Int           @id @default(autoincrement())
  title      String
  startDate  DateTime
  isRepeat   Boolean       @default(false)
  repeatType RepeatType?
  note       String?
  userId     Int
  targetId   Int
  categoryId Int
  createdAt  DateTime      @default(now())
  category   EventCategory @relation(fields: [categoryId], references: [id])
  target     Target        @relation(fields: [targetId], references: [id])
  user       User          @relation(fields: [userId], references: [id])
  reminders  Reminder[]
}

model Target {
  id        Int        @id @default(autoincrement())
  name      String
  type      TargetType
  avatarUrl String?
  createdAt DateTime   @default(now())
  events    Event[]
}

model EventCategory {
  id       Int     @id @default(autoincrement())
  key      String  @unique
  name     String
  icon     String?
  isSystem Boolean @default(true)
  events   Event[]
}

model Reminder {
  id        Int             @id @default(autoincrement())
  eventId   Int
  remindAt  DateTime
  channel   ReminderChannel @default(IN_APP)
  status    ReminderStatus  @default(PENDING)
  isActive  Boolean         @default(true)
  sentAt    DateTime?
  createdAt DateTime        @default(now())
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

enum RepeatType {
  YEARLY
  MONTHLY
}

enum TagType {
  RELATIONSHIP
  OCCASION
  BUDGET
  INTEREST
}

enum TargetType {
  PERSON
  PET
  GROUP
  WORK
  OTHER
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum ReminderChannel {
  IN_APP
  EMAIL
  PUSH
}
